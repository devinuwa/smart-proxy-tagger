# Copy to .env and fill in the ElevenLabs key locally.
# Never commit .env. These values are names and local defaults only.

# ElevenLabs text-to-speech. Used only for the job-complete voice notification.
ELEVENLABS_API_KEY=
# Premade voice returned by this account's voice list (George). The old public
# Rachel id is treated as a library voice and a free key gets HTTP 402.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Local TimescaleDB + pgvector. Host must stay on loopback.
DATABASE_URL=postgresql://smartproxy:smartproxy@127.0.0.1:15432/smartproxy

# Local Temporal dev server (temporal server start-dev).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=smart-proxy-tagger
